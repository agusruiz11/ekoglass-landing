# Copiar a .env (no se versiona). En el servidor de RH Studio estas variables
# se cargan en el cPanel (Setup Node.js App → Environment variables).
# Ver src/lib/mail.ts y docs/entrega-rh.md.

# Envío de formularios por SMTP (desde el 21/10/2026, antes Resend).
SMTP_HOST=mail.ejemplo.com.ar
SMTP_PORT=465
SMTP_USER=web@ejemplo.com.ar
SMTP_PASS=xxxxxxxx
CONTACT_TO=estefania.cruz@ar.nsg.com
CONTACT_FROM="Ekoglass Web <web@ekoglass.com.ar>"

# Medición (públicas: viajan al navegador). Se leen AL COMPILAR: si cambian,
# hay que volver a compilar y entregar. Sin ellas no se carga ningún tag.
# Ver docs/medicion.md.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# Panel de mediciones: se lee al compilar. Ver src/app/panel-de-mediciones/layout.tsx
PANEL_HABILITADO=false
